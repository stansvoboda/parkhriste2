# Kopírujte tento soubor jako .env.local a vyplňte vaše skutečné hodnoty

# Supabase konfigurace
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# Golemio API klíč – bez prefixu VITE_, používá ho jen dev proxy / Cloudflare Function
GOLEMIO_KEY=your_golemio_api_key_here
